    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Base terracotta vertical gradient -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
