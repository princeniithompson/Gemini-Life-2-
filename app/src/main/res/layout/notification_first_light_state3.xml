<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_notif_cream"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp">

    <!-- Header Row: Flame in Circle + "First Light" + "now" + chevron down -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_notif_flame_circle"
            android:contentDescription="First Light" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="First Light"
            android:textColor="#2C2420"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="now"
            android:textColor="#8B7E72"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_notif_chevron_down"
            android:contentDescription="Expand" />
    </LinearLayout>

    <!-- Body text + Green checkmark circle on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/notif_body_state3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Snoozed. We'll gently remind you at 6:15 AM."
            android:textColor="#2C2420"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <ImageView
            android:id="@+id/notif_icon_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_notif_check_circle"
            android:contentDescription="Confirmed" />
    </LinearLayout>

</LinearLayout>
